package co.edu.uniquindio.ProjectoFinal;

import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;

import java.util.logging.Logger;

import static org.junit.jupiter.api.Assertions.*;

class AdministradorAlojamientoTest {

    private static final Logger LOG = Logger.getLogger(AdministradorAlojamientoTest.class.getName());

    @DisplayName("Prueba assertNotNull")
    @Test
    void testNotNull(){

        AdministradorAlojamiento actual= new AdministradorAlojamiento("Roberto Perez", "4840562", "3136792307", "perezr@gmali.com", "RobertPerez", "");

        assertNotNull(actual);

        LOG.info(actual.toString());
        LOG.info("Finalizando prueba administrador alojamiento");
    }
    @DisplayName("Prueba assertTrue")
    @Test
    void testTrue(){

        LOG.info("Iniciando prueba administrador alojamiento...");

        AdministradorAlojamiento aa= new AdministradorAlojamiento("Roberto Perez", "4840562", "3136792307", "perezr@gmail.com", "RobertPerez", "5678");

        assertTrue(aa.autenticar("RobertPerez", "5678"));
        assertFalse(aa.autenticar("RobPeres", "1010"));
        assertFalse(aa.getPermisos().isEmpty());

        LOG.info("Finalizando prueba administrador alojamiento");

    }
}
