package co.edu.uniquindio.ProjectoFinal;

import org.junit.jupiter.api.Disabled;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;

import java.time.LocalDate;
import java.time.LocalDateTime;
import java.util.logging.Logger;

import static org.junit.jupiter.api.Assertions.*;

class ConflictoCanalTest {

    private static final Logger LOG = Logger.getLogger(ConflictoCanalTest.class.getName());

    @Disabled("Conflictos canales con distintos datos")
    @Test
    void testNotEquals(){

        LOG.info("Iniciando prueba conflicto canal");

        LocalDateTime fecha= LocalDateTime.of(2026, 11, 5, 4, 0);

        ConflictoCanal cc= new ConflictoCanal("R-987", "A101", LocalDate.of(2026, 11, 5), LocalDate.of(2026, 11, 8), "Choca con una reserva", fecha);
        ConflictoCanal d= new ConflictoCanal("R-987", "A103", LocalDate.of(2026, 11, 6), LocalDate.of(2026, 11, 9), "Choca con una reserva", fecha);

        assertNotEquals(d, cc);

        LOG.info("Finalizando prueba conflicto canal");
    }
    @DisplayName("Prueba asssertTrue/ assertFalse")
    @Test
    void testFalseTrue(){

        LOG.info("Iniciando prueba conflicto canal");

        ConflictoCanal registrado= new ConflictoCanal("R-987", "A103", LocalDate.of(2026, 11, 5), LocalDate.of(2026, 11, 8), "", LocalDateTime.now());
        ConflictoCanal percibido= new ConflictoCanal("R-987", "A101", LocalDate.of(2026, 10, 7), LocalDate.of(2026, 10, 14), "", LocalDateTime.now());
        ConflictoCanal mismo= registrado;

        assertTrue(registrado == mismo);
        assertTrue(registrado != percibido);
        assertFalse(registrado == percibido);

        LOG.info("El conflicto del canal es:" + registrado.toString());
        LOG.info("Finalizando prueba conflicto canal");
    }
}
