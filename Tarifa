package co.edu.uniquindio.ProjectoFinal;

import java.time.LocalDate;

public class Tarifa {
    private int valorPersonaNoche;
    private TemporadaAlojamiento temporada;

    public Tarifa(int valorPersonaNoche, TemporadaAlojamiento temporada ) {
        this.valorPersonaNoche = valorPersonaNoche;
        this.temporada= temporada;
    }

    public int getValorPersonaNoche() {
        return valorPersonaNoche;
    }

    public void setValorPersonaNoche(int valorPersonaNoche) {
        this.valorPersonaNoche = valorPersonaNoche;
    }
    public TemporadaAlojamiento getTemporada() {
        return temporada;
    }

    public void setTemporada(TemporadaAlojamiento temporada) {
        this.temporada = temporada;
    }

}
